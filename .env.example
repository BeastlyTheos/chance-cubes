# Names only. Copy to .env and fill in; never commit .env.
DISCORD_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the key's newlines as the two characters \n, all on one line.
FIREBASE_PRIVATE_KEY=

# Optional runtime settings (defaults shown)
DISCORD_ADMIN_ID=
BOT_PREFIX=!
MAX_ROLLS_PER_DIE=1000
FIREBASE_DATABASE_URL=

# Optional emoji-source guild IDs used by emoji build tooling
EMOJI_GUILD_SWRPG=
EMOJI_GUILD_GENESYS=
EMOJI_GUILD_L5R=
EMOJI_GUILD_BUTTON=
